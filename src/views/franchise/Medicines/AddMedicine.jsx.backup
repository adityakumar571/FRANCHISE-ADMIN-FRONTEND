/* eslint-disable prettier/prettier */
/**
 * AddMedicine — Production-Level Medicine Entry
 * Features: Rack Location, Batch Management, Barcode, Images, Complete Validation
 */
import { useState, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import { FlaskConical, ArrowLeft, Save, Upload, Plus, Trash2, QrCode, MapPin, Package } from 'lucide-react'
import toast from 'react-hot-toast'
import PageHeader from '../components/PageHeader'
import { postRequest, getRequest } from '../../../Helpers'

const FL = ({ label, required, children, hint }) => (
  <div>
    <label style={{ fontSize: 11, fontWeight: 700, color: '#374151', display: 'block', marginBottom: 5, textTransform: 'uppercase', letterSpacing: '0.4px' }}>
      {label}{required && <span style={{ color: '#dc2626', marginLeft: 2 }}>*</span>}
    </label>
    {hint && <p style={{ margin: '0 0 4px', fontSize: 10, color: '#9ca3af' }}>{hint}</p>}
    {children}
  </div>
)

const Input = ({ value, onChange, placeholder, type = 'text', disabled, min, max, step }) => (
  <input type={type} value={value} onChange={onChange} placeholder={placeholder} disabled={disabled} min={min} max={max} step={step}
    style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', background: disabled ? '#f9fafb' : '#fff', boxSizing: 'border-box', color: '#111827' }}
    onFocus={e => { if (!disabled) e.target.style.borderColor = '#0c3b73' }}
    onBlur={e => e.target.style.borderColor = '#e5e7eb'}
  />
)

const Sel = ({ value, onChange, opts, placeholder }) => (
  <select value={value} onChange={onChange}
    style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', background: '#fff', cursor: 'pointer', color: value ? '#111827' : '#9ca3af' }}>
    {placeholder && <option value="">{placeholder}</option>}
    {opts.map(o => <option key={o} value={o}>{o}</option>)}
  </select>
)

const Section = ({ title, icon: Icon, children }) => (
  <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 12, overflow: 'hidden', marginBottom: 16 }}>
    <div style={{ padding: '12px 18px', background: 'linear-gradient(135deg, #f8faff, #eff6ff)', borderBottom: '1px solid #e0e7ff', display: 'flex', alignItems: 'center', gap: 8 }}>
      {Icon && <Icon size={16} color="#0c3b73" />}
      <p style={{ margin: 0, fontSize: 13, fontWeight: 700, color: '#0c3b73' }}>{title}</p>
    </div>
    <div style={{ padding: '18px 18px', display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(200px,1fr))', gap: 14 }}>
      {children}
    </div>
  </div>
)

const GST_RATES = ['0%','5%','12%','18%','28%']
const CATEGORIES_DEFAULT   = ['Analgesic','Antibiotic','Antifungal','Antiviral','Antacid','Vitamin','Supplement','Cardiac','Diabetic','Respiratory','Dermatology','Gastro','Neuro','Other']
const FORMULATIONS_DEFAULT = ['Tablet','Capsule','Syrup','Injection','Ointment','Cream','Gel','Drops','Powder','Sachet','Suspension','Lotion']
const COMPANIES_DEFAULT    = ['Sun Pharma','Cipla','Lupin','Dr. Reddy\'s','Alkem','Mankind','Torrent','Abbott','GSK','Pfizer','Zydus','Intas','Cadila','Other']
const UNITS_DEFAULT        = ['Tablet','Capsule','ml','mg','gm','Strip','Bottle','Sachet','Tube','Vial','Ampule']
const RACKS                = ['RACK-A','RACK-B','RACK-C','RACK-D','RACK-E','RACK-F']
const ROWS                 = ['A','B','C','D','E','F','G','H','I','J']
const SCHEDULES            = ['None','H','H1','X','G']

export default function AddMedicine() {
  const navigate = useNavigate()
  const [form, setForm] = useState({
    // Basic Info
    name: '', salt: '', brand: '', genericName: '', category: '', formulation: '',
    company: '', strength: '', unit: 'Tablet', packSize: '', description: '',
    
    // Pricing & Tax
    mrp: '', purchasePrice: '', sellingPrice: '', gst: '12%', gstPercent: 12, hsnCode: '3004',
    
    // Regulatory
    schedule: 'None', requiresPrescription: false,
    
    // Stock
    reorderLevel: '10', minStock: '5', maxStock: '1000', openingStock: '0',
    
    // Barcode
    barcode: '', sku: '',
    
    // Rack Location
    rackLocation: { rackId: '', shelf: '', row: '', column: '', position: '' },
    
    // Batch (Initial)
    batches: [{
      batchNo: '',
      mfgDate: '',
      expiryDate: '',
      quantity: '',
      mrp: '',
      purchasePrice: '',
      supplierName: ''
    }],
    
    // Images
    images: [],
    imageUrl: '',
    
    // Dimensions
    dimensions: { length: '', width: '', height: '', weight: '' }
  })
  
  const [saving, setSaving]         = useState(false)
  const [categories, setCategories]     = useState(CATEGORIES_DEFAULT)
  const [formulations, setFormulations] = useState(FORMULATIONS_DEFAULT)
  const [companies, setCompanies]       = useState(COMPANIES_DEFAULT)
  const [units, setUnits]               = useState(UNITS_DEFAULT)
  const [uploadingImage, setUploadingImage] = useState(false)

  // Load masters
  useEffect(() => {
    getRequest('/franchise/medicines/masters/all').then(res => {
      const d = res?.data?.data
      if (d?.categories?.length) setCategories(d.categories.map(c => c.name))
      if (d?.units?.length)      setUnits(d.units.map(u => u.name))
      if (d?.companies?.length)  setCompanies(d.companies.map(c => c.name))
      if (d?.formulations?.length) setFormulations(d.formulations.map(f => f.name))
    }).catch(() => {})
  }, [])

  const set = k => e => setForm(p => ({ ...p, [k]: e.target.value }))
  const setCheck = k => e => setForm(p => ({ ...p, [k]: e.target.checked }))
  const setNested = (parent, key) => e => setForm(p => ({ ...p, [parent]: { ...p[parent], [key]: e.target.value } }))

  // Auto-calculate position
  useEffect(() => {
    const { rackId, shelf, row, column } = form.rackLocation
    if (rackId && shelf && row && column) {
      const position = `${rackId}-${shelf}-${row}-${column}`
      setForm(p => ({ ...p, rackLocation: { ...p.rackLocation, position } }))
    }
  }, [form.rackLocation.rackId, form.rackLocation.shelf, form.rackLocation.row, form.rackLocation.column])

  // Generate Barcode
  const generateBarcode = () => {
    const timestamp = Date.now().toString().slice(-8)
    const random = Math.floor(Math.random() * 1000).toString().padStart(3, '0')
    const barcode = `MED${timestamp}${random}`
    setForm(p => ({ ...p, barcode }))
    toast.success('Barcode generated!')
  }

  // Add Batch
  const addBatch = () => {
    setForm(p => ({
      ...p,
      batches: [...p.batches, {
        batchNo: '',
        mfgDate: '',
        expiryDate: '',
        quantity: '',
        mrp: p.mrp || '',
        purchasePrice: p.purchasePrice || '',
        supplierName: ''
      }]
    }))
  }

  // Remove Batch
  const removeBatch = (index) => {
    setForm(p => ({
      ...p,
      batches: p.batches.filter((_, i) => i !== index)
    }))
  }

  // Update Batch
  const updateBatch = (index, field, value) => {
    setForm(p => ({
      ...p,
      batches: p.batches.map((batch, i) => i === index ? { ...batch, [field]: value } : batch)
    }))
  }

  // Image Upload
  const handleImageUpload = async (e) => {
    const file = e.target.files?.[0]
    if (!file) return
    
    if (!file.type.startsWith('image/')) {
      toast.error('Please upload an image file')
      return
    }
    
    setUploadingImage(true)
    const formData = new FormData()
    formData.append('image', file)
    
    try {
      const res = await fetch('/api/franchise/medicines/upload-image', {
        method: 'POST',
        body: formData
      })
      const data = await res.json()
      if (data.success) {
        setForm(p => ({
          ...p,
          imageUrl: data.data.url,
          images: [...p.images, data.data.url]
        }))
        toast.success('Image uploaded!')
      }
    } catch (err) {
      toast.error('Image upload failed')
    } finally {
      setUploadingImage(false)
    }
  }

  const handleSave = async () => {
    // Validation
    if (!form.name.trim()) { toast.error('Medicine name is required'); return }
    if (!form.salt.trim()) { toast.error('Salt/Generic name is required'); return }
    if (!form.mrp) { toast.error('MRP is required'); return }
    if (!form.category) { toast.error('Category is required'); return }
    if (!form.formulation) { toast.error('Formulation is required'); return }
    
    // Rack location validation
    if (!form.rackLocation.rackId) { toast.error('Rack location is required'); return }
    if (!form.rackLocation.shelf) { toast.error('Shelf number is required'); return }
    if (!form.rackLocation.row) { toast.error('Row is required'); return }
    if (!form.rackLocation.column) { toast.error('Column is required'); return }
    
    // At least one batch required
    const validBatches = form.batches.filter(b => b.batchNo && b.expiryDate && b.quantity)
    if (validBatches.length === 0) {
      toast.error('At least one complete batch is required (Batch No, Expiry Date, Quantity)')
      return
    }

    setSaving(true)
    try {
      const payload = {
        ...form,
        mrp:            parseFloat(form.mrp)           || 0,
        purchasePrice:  parseFloat(form.purchasePrice) || 0,
        sellingPrice:   parseFloat(form.sellingPrice)  || parseFloat(form.mrp) || 0,
        gstPercent:     parseFloat(form.gstPercent)    || 12,
        reorderLevel:   parseInt(form.reorderLevel)    || 10,
        minStock:       parseInt(form.minStock)        || 5,
        maxStock:       parseInt(form.maxStock)        || 1000,
        openingStock:   parseInt(form.openingStock)    || 0,
        rackLocation: {
          ...form.rackLocation,
          shelf: parseInt(form.rackLocation.shelf),
          column: parseInt(form.rackLocation.column)
        },
        batches: validBatches.map(b => ({
          ...b,
          quantity: parseInt(b.quantity),
          availableQty: parseInt(b.quantity),
          mrp: parseFloat(b.mrp) || parseFloat(form.mrp),
          purchasePrice: parseFloat(b.purchasePrice) || parseFloat(form.purchasePrice),
          mfgDate: b.mfgDate || undefined,
          isActive: true
        })),
        isBatchTracked: true,
        dimensions: {
          length: parseFloat(form.dimensions.length) || undefined,
          width: parseFloat(form.dimensions.width) || undefined,
          height: parseFloat(form.dimensions.height) || undefined,
          weight: parseFloat(form.dimensions.weight) || undefined,
        }
      }
      
      await postRequest({ url: '/franchise/medicines', cred: payload })
      toast.success('✅ Medicine added successfully with rack location!')
      navigate('/franchise/medicines')
    } catch (err) {
      toast.error(err?.response?.data?.message || 'Failed to add medicine')
    } finally {
      setSaving(false)
    }
  }

  return (
    <div style={{ fontFamily: 'Inter,sans-serif', padding: '0 0 40px' }}>
      <PageHeader
        icon={FlaskConical}
        title="Add New Medicine"
        description="Complete medicine entry with rack location and batch details"
        actions={
          <div style={{ display: 'flex', gap: 10 }}>
            <button onClick={() => navigate(-1)}
              style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 16px', border: '1px solid #e5e7eb', borderRadius: 8, background: '#fff', fontSize: 13, fontWeight: 600, cursor: 'pointer' }}>
              <ArrowLeft size={14} /> Back
            </button>
            <button onClick={handleSave} disabled={saving}
              style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 20px', border: 'none', borderRadius: 8, background: saving ? '#93c5fd' : '#0c3b73', color: '#fff', fontSize: 13, fontWeight: 700, cursor: saving ? 'not-allowed' : 'pointer' }}>
              <Save size={14} /> {saving ? 'Saving...' : 'Save Medicine'}
            </button>
          </div>
        }
      />

      <div style={{ maxWidth: 1400, margin: '0 auto' }}>
        
        {/* Basic Information */}
        <Section title="Basic Information" icon={Package}>
          <FL label="Medicine Name" required>
            <Input value={form.name} onChange={set('name')} placeholder="e.g. Paracetamol 500mg" />
          </FL>
          <FL label="Generic / Salt Name" required>
            <Input value={form.salt} onChange={set('salt')} placeholder="e.g. Acetaminophen" />
          </FL>
          <FL label="Brand Name">
            <Input value={form.brand} onChange={set('brand')} placeholder="e.g. Dolo" />
          </FL>
          <FL label="Category" required>
            <Sel value={form.category} onChange={set('category')} opts={categories} placeholder="Select category" />
          </FL>
          <FL label="Formulation" required>
            <Sel value={form.formulation} onChange={set('formulation')} opts={formulations} placeholder="Select formulation" />
          </FL>
          <FL label="Company">
            <Sel value={form.company} onChange={set('company')} opts={companies} placeholder="Select company" />
          </FL>
          <FL label="Strength">
            <Input value={form.strength} onChange={set('strength')} placeholder="e.g. 500mg" />
          </FL>
          <FL label="Unit">
            <Sel value={form.unit} onChange={set('unit')} opts={units} />
          </FL>
          <FL label="Pack Size">
            <Input value={form.packSize} onChange={set('packSize')} placeholder="e.g. 1x10, Strip of 10" />
          </FL>
          <div style={{ gridColumn: '1 / -1' }}>
            <FL label="Description">
              <textarea value={form.description} onChange={set('description')} placeholder="Medicine description, usage, warnings..."
                style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, minHeight: 60, fontFamily: 'inherit', resize: 'vertical' }} />
            </FL>
          </div>
        </Section>

        {/* Pricing & Tax */}
        <Section title="Pricing & Tax Information" icon={Package}>
          <FL label="MRP (₹)" required>
            <Input type="number" value={form.mrp} onChange={set('mrp')} placeholder="0.00" step="0.01" min="0" />
          </FL>
          <FL label="Purchase Price (₹)">
            <Input type="number" value={form.purchasePrice} onChange={set('purchasePrice')} placeholder="0.00" step="0.01" min="0" />
          </FL>
          <FL label="Selling Price (₹)">
            <Input type="number" value={form.sellingPrice} onChange={set('sellingPrice')} placeholder="Auto from MRP" step="0.01" min="0" />
          </FL>
          <FL label="GST %">
            <Sel value={form.gst} onChange={e => {
              set('gst')(e)
              setForm(p => ({ ...p, gstPercent: parseFloat(e.target.value) || 0 }))
            }} opts={GST_RATES} />
          </FL>
          <FL label="HSN Code">
            <Input value={form.hsnCode} onChange={set('hsnCode')} placeholder="3004" />
          </FL>
          <FL label="Schedule">
            <Sel value={form.schedule} onChange={set('schedule')} opts={SCHEDULES} />
          </FL>
          <div style={{ gridColumn: '1 / -1', display: 'flex', alignItems: 'center', gap: 8 }}>
            <input type="checkbox" checked={form.requiresPrescription} onChange={setCheck('requiresPrescription')} id="prescription" />
            <label htmlFor="prescription" style={{ fontSize: 13, color: '#374151', cursor: 'pointer' }}>Requires Prescription</label>
          </div>
        </Section>

        {/* Rack Location */}
        <Section title="📍 Rack Location (Required)" icon={MapPin}>
          <FL label="Rack" required>
            <Sel value={form.rackLocation.rackId} onChange={setNested('rackLocation', 'rackId')} opts={RACKS} placeholder="Select rack" />
          </FL>
          <FL label="Shelf Number" required>
            <Input type="number" value={form.rackLocation.shelf} onChange={setNested('rackLocation', 'shelf')} placeholder="1-10" min="1" max="10" />
          </FL>
          <FL label="Row" required>
            <Sel value={form.rackLocation.row} onChange={setNested('rackLocation', 'row')} opts={ROWS} placeholder="Select row" />
          </FL>
          <FL label="Column" required>
            <Input type="number" value={form.rackLocation.column} onChange={setNested('rackLocation', 'column')} placeholder="1-20" min="1" max="20" />
          </FL>
          {form.rackLocation.position && (
            <div style={{ gridColumn: '1 / -1', padding: '12px', background: '#dcfce7', border: '1px solid #86efac', borderRadius: 8 }}>
              <p style={{ margin: 0, fontSize: 13, fontWeight: 700, color: '#15803d' }}>
                📦 Position: <span style={{ fontFamily: 'monospace', fontSize: 14 }}>{form.rackLocation.position}</span>
              </p>
              <p style={{ margin: '4px 0 0', fontSize: 11, color: '#16a34a' }}>
                This medicine will be stored at {form.rackLocation.position}
              </p>
            </div>
          )}
        </Section>

        {/* Batch Management */}
        <Section title="📦 Batch Details (Required)" icon={Package}>
          <div style={{ gridColumn: '1 / -1' }}>
            {form.batches.map((batch, index) => (
              <div key={index} style={{ background: '#f9fafb', border: '1px solid #e5e7eb', borderRadius: 8, padding: 16, marginBottom: 12 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                  <p style={{ margin: 0, fontSize: 13, fontWeight: 700, color: '#0c3b73' }}>Batch #{index + 1}</p>
                  {form.batches.length > 1 && (
                    <button onClick={() => removeBatch(index)} style={{ background: 'none', border: 'none', color: '#dc2626', cursor: 'pointer', padding: 4 }}>
                      <Trash2 size={16} />
                    </button>
                  )}
                </div>
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(180px, 1fr))', gap: 12 }}>
                  <FL label="Batch Number" required>
                    <Input value={batch.batchNo} onChange={e => updateBatch(index, 'batchNo', e.target.value)} placeholder="e.g. BTH12345" />
                  </FL>
                  <FL label="Manufacturing Date">
                    <Input type="date" value={batch.mfgDate} onChange={e => updateBatch(index, 'mfgDate', e.target.value)} />
                  </FL>
                  <FL label="Expiry Date" required>
                    <Input type="date" value={batch.expiryDate} onChange={e => updateBatch(index, 'expiryDate', e.target.value)} />
                  </FL>
                  <FL label="Quantity" required>
                    <Input type="number" value={batch.quantity} onChange={e => updateBatch(index, 'quantity', e.target.value)} placeholder="0" min="1" />
                  </FL>
                  <FL label="Batch MRP">
                    <Input type="number" value={batch.mrp} onChange={e => updateBatch(index, 'mrp', e.target.value)} placeholder={form.mrp || '0.00'} step="0.01" />
                  </FL>
                  <FL label="Batch Purchase Price">
                    <Input type="number" value={batch.purchasePrice} onChange={e => updateBatch(index, 'purchasePrice', e.target.value)} placeholder={form.purchasePrice || '0.00'} step="0.01" />
                  </FL>
                  <FL label="Supplier Name">
                    <Input value={batch.supplierName} onChange={e => updateBatch(index, 'supplierName', e.target.value)} placeholder="Supplier" />
                  </FL>
                </div>
              </div>
            ))}
            <button onClick={addBatch}
              style={{ display: 'flex', alignItems: 'center', gap: 6, padding: '8px 16px', border: '1px dashed #0c3b73', borderRadius: 8, background: '#fff', color: '#0c3b73', fontSize: 13, fontWeight: 600, cursor: 'pointer' }}>
              <Plus size={14} /> Add Another Batch
            </button>
          </div>
        </Section>

        {/* Barcode & SKU */}
        <Section title="🏷️ Barcode & Identification" icon={QrCode}>
          <FL label="Barcode">
            <div style={{ display: 'flex', gap: 8 }}>
              <Input value={form.barcode} onChange={set('barcode')} placeholder="Auto-generated or enter manually" />
              <button onClick={generateBarcode}
                style={{ padding: '0 16px', border: '1px solid #0c3b73', borderRadius: 8, background: '#fff', color: '#0c3b73', fontSize: 12, fontWeight: 600, cursor: 'pointer', whiteSpace: 'nowrap' }}>
                <QrCode size={14} style={{ display: 'inline', verticalAlign: 'middle', marginRight: 4 }} />
                Generate
              </button>
            </div>
          </FL>
          <FL label="SKU">
            <Input value={form.sku} onChange={set('sku')} placeholder="Stock Keeping Unit" />
          </FL>
        </Section>

        {/* Stock Settings */}
        <Section title="📊 Stock Management" icon={Package}>
          <FL label="Reorder Level">
            <Input type="number" value={form.reorderLevel} onChange={set('reorderLevel')} placeholder="10" min="0" />
          </FL>
          <FL label="Minimum Stock">
            <Input type="number" value={form.minStock} onChange={set('minStock')} placeholder="5" min="0" />
          </FL>
          <FL label="Maximum Stock">
            <Input type="number" value={form.maxStock} onChange={set('maxStock')} placeholder="1000" min="0" />
          </FL>
          <FL label="Opening Stock" hint="Initial stock quantity (will be added as first batch if no batches entered)">
            <Input type="number" value={form.openingStock} onChange={set('openingStock')} placeholder="0" min="0" />
          </FL>
        </Section>

        {/* Image Upload */}
        <Section title="📷 Medicine Image" icon={Upload}>
          <div style={{ gridColumn: '1 / -1' }}>
            <FL label="Upload Image">
              <input type="file" accept="image/*" onChange={handleImageUpload} disabled={uploadingImage}
                style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, cursor: 'pointer' }} />
            </FL>
            {uploadingImage && <p style={{ fontSize: 12, color: '#9ca3af', marginTop: 8 }}>Uploading...</p>}
            {form.imageUrl && (
              <div style={{ marginTop: 12 }}>
                <img src={form.imageUrl} alt="Medicine" style={{ maxWidth: 200, height: 'auto', borderRadius: 8, border: '1px solid #e5e7eb' }} />
              </div>
            )}
          </div>
        </Section>

        {/* Dimensions (Optional) */}
        <Section title="📐 Physical Dimensions (Optional)" icon={Package}>
          <FL label="Length (cm)">
            <Input type="number" value={form.dimensions.length} onChange={setNested('dimensions', 'length')} placeholder="0" step="0.1" min="0" />
          </FL>
          <FL label="Width (cm)">
            <Input type="number" value={form.dimensions.width} onChange={setNested('dimensions', 'width')} placeholder="0" step="0.1" min="0" />
          </FL>
          <FL label="Height (cm)">
            <Input type="number" value={form.dimensions.height} onChange={setNested('dimensions', 'height')} placeholder="0" step="0.1" min="0" />
          </FL>
          <FL label="Weight (grams)">
            <Input type="number" value={form.dimensions.weight} onChange={setNested('dimensions', 'weight')} placeholder="0" step="0.1" min="0" />
          </FL>
        </Section>

        {/* Save Button */}
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 12, marginTop: 24 }}>
          <button onClick={() => navigate(-1)}
            style={{ padding: '10px 24px', border: '1px solid #e5e7eb', borderRadius: 8, background: '#fff', fontSize: 14, fontWeight: 600, cursor: 'pointer' }}>
            Cancel
          </button>
          <button onClick={handleSave} disabled={saving}
            style={{ padding: '10px 32px', border: 'none', borderRadius: 8, background: saving ? '#93c5fd' : 'linear-gradient(135deg, #0c3b73, #1e40af)', color: '#fff', fontSize: 14, fontWeight: 700, cursor: saving ? 'not-allowed' : 'pointer', boxShadow: '0 4px 12px rgba(12,59,115,0.3)' }}>
            {saving ? 'Saving Medicine...' : '✅ Save Medicine'}
          </button>
        </div>

      </div>
    </div>
  )
}
        <div>
          {/* Basic Info */}
          <Section title="Basic Information">
            <FL label="Medicine Name" required>
              <Input value={form.name} onChange={set('name')} placeholder="e.g. Paracetamol 650mg Tablet" />
            </FL>
            <FL label="Salt / Generic Name" required>
              <Input value={form.salt} onChange={set('salt')} placeholder="e.g. Paracetamol 650mg" />
            </FL>
            <FL label="Brand Name">
              <Input value={form.brand} onChange={set('brand')} placeholder="e.g. Crocin" />
            </FL>
            <FL label="Medicine Category">
              <Sel value={form.category} onChange={set('category')} opts={categories} />
            </FL>
            <FL label="Select Formulation">
              <Sel value={form.formulation} onChange={set('formulation')} opts={formulations} />
            </FL>
            <FL label="Strength">
              <Input value={form.strength} onChange={set('strength')} placeholder="e.g. 650 mg" />
            </FL>
            <FL label="Unit">
              <Sel value={form.unit} onChange={set('unit')} opts={units} />
            </FL>
            <FL label="Company / Manufacturer">
              <Sel value={form.company} onChange={set('company')} opts={companies} />
            </FL>
            <FL label="HSN Code">
              <Input value={form.hsn} onChange={set('hsn')} placeholder="3004" />
            </FL>
            <FL label="GST Rate">
              <Sel value={form.gst} onChange={set('gst')} opts={GST_RATES} />
            </FL>
          </Section>

          {/* Pricing & Stock */}
          <Section title="Pricing & Stock">
            <FL label="MRP (₹)" required>
              <Input value={form.mrp} onChange={set('mrp')} placeholder="0.00" type="number" />
            </FL>
            <FL label="Purchase Price (₹)">
              <Input value={form.purchasePrice} onChange={set('purchasePrice')} placeholder="0.00" type="number" />
            </FL>
            <FL label="Opening Stock">
              <Input value={form.openingStock} onChange={set('openingStock')} placeholder="0" type="number" />
            </FL>
            <FL label="Reorder Level">
              <Input value={form.reorderLevel} onChange={set('reorderLevel')} placeholder="100" type="number" />
            </FL>
          </Section>

          {/* Other Info */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 12, overflow: 'hidden' }}>
            <div style={{ padding: '12px 18px', background: '#f9fafb', borderBottom: '1px solid #e5e7eb' }}>
              <p style={{ margin: 0, fontSize: 13, fontWeight: 700, color: '#374151' }}>Other Information</p>
            </div>
            <div style={{ padding: '18px' }}>
              <div style={{ marginBottom: 14 }}>
                <FL label="Description">
                  <textarea value={form.description} onChange={set('description')} rows={3}
                    placeholder="Medicine description, usage, side effects..."
                    style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', resize: 'vertical', boxSizing: 'border-box' }} />
                </FL>
              </div>
              <label style={{ display: 'flex', alignItems: 'center', gap: 8, cursor: 'pointer', fontSize: 13 }}>
                <input type="checkbox" checked={form.prescription} onChange={setCheck('prescription')}
                  style={{ width: 15, height: 15, accentColor: '#0c3b73' }} />
                <span style={{ fontWeight: 500, color: '#374151' }}>Prescription Required (Rx)</span>
              </label>
            </div>
          </div>
        </div>

        {/* Right: Image Upload + Pack Size + Save */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
          {/* Image Upload */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 12, padding: 18 }}>
            <p style={{ fontSize: 12, fontWeight: 700, color: '#374151', margin: '0 0 12px', textTransform: 'uppercase' }}>Upload Image</p>
            <div style={{ border: '2px dashed #e5e7eb', borderRadius: 10, padding: '28px 16px', textAlign: 'center', cursor: 'pointer', background: '#f9fafb' }}
              onMouseEnter={e => e.currentTarget.style.borderColor='#0c3b73'}
              onMouseLeave={e => e.currentTarget.style.borderColor='#e5e7eb'}>
              <Upload size={28} color="#9ca3af" style={{ margin: '0 auto 10px', display: 'block' }} />
              <p style={{ fontSize: 12, color: '#6b7280', margin: '0 0 4px', fontWeight: 600 }}>Click or drag to upload</p>
              <p style={{ fontSize: 10, color: '#9ca3af', margin: 0 }}>PNG, JPG up to 2MB</p>
            </div>
          </div>

          {/* Pack Size */}
          <div style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 12, padding: 18 }}>
            <FL label="Pack Size">
              <Input value={form.packSize} onChange={set('packSize')} placeholder="e.g. 1x15 Strips" />
            </FL>
          </div>

          {/* Action Buttons */}
          <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            <button onClick={handleSave} disabled={saving}
              style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 7, padding: '11px', background: saving ? '#9ca3af' : '#0c3b73', border: 'none', borderRadius: 9, fontSize: 14, fontWeight: 700, color: '#fff', cursor: saving ? 'not-allowed' : 'pointer' }}>
              <Save size={15} /> {saving ? 'Saving...' : 'Save Medicine'}
            </button>
            <button onClick={() => navigate('/franchise/medicines')}
              style={{ padding: '10px', background: '#fff', border: '1px solid #e5e7eb', borderRadius: 9, fontSize: 13, fontWeight: 600, color: '#374151', cursor: 'pointer' }}>
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}
